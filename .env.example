# =============================================
# CONFIGURAÇÕES DO AMBIENTE - Plataforma Imobiliária
# Copie este arquivo para .env e preencha os valores
# =============================================

# -----------------------------------------------
# APLICAÇÃO
# -----------------------------------------------
# Ambiente de execução: development | production | test
NODE_ENV=development
# Porta da API backend
APP_PORT=3001
# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------
# BANCO DE DADOS PostgreSQL
# -----------------------------------------------
DATABASE_URL=postgresql://postgres:senha_segura@localhost:5432/plataforma_imobiliaria
POSTGRES_DB=plataforma_imobiliaria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=senha_segura
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------
# REDIS - Cache e Filas
# -----------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_senha_segura
REDIS_DB=0
# URL completa do Redis
REDIS_URL=redis://:redis_senha_segura@localhost:6379/0

# -----------------------------------------------
# JWT - Tokens de Autenticação
# -----------------------------------------------
# Segredo do access token - mínimo 64 caracteres aleatórios
JWT_ACCESS_SECRET=seu_access_secret_muito_seguro_minimo_64_chars_aqui_123456789012345
# Segredo do refresh token - diferente do access
JWT_REFRESH_SECRET=seu_refresh_secret_muito_seguro_minimo_64_chars_aqui_987654321098765
# Expiração do access token (formato: 15m, 1h, etc)
JWT_ACCESS_EXPIRES_IN=15m
# Expiração do refresh token
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------
# SEGURANÇA - Criptografia
# -----------------------------------------------
# Chave AES-256: deve ter exatamente 32 bytes (256 bits) em hex
ENCRYPTION_KEY=6368616e676520746869732070617373776f726420746f206120736563726574
# Segredo HMAC-SHA256
HMAC_SECRET=seu_hmac_secret_muito_seguro_aqui_minimo_32_chars

# -----------------------------------------------
# E-MAIL - Nodemailer
# -----------------------------------------------
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@seudominio.com.br
SMTP_PASS=senha_smtp_segura
SMTP_FROM_NAME=Plataforma Imobiliária
SMTP_FROM_EMAIL=noreply@seudominio.com.br

# -----------------------------------------------
# MINIO - Armazenamento de Arquivos
# -----------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_senha_segura
MINIO_BUCKET_NAME=plataforma-imobiliaria
# URL pública do MinIO
MINIO_PUBLIC_URL=http://localhost:9000

# -----------------------------------------------
# RATE LIMITING
# -----------------------------------------------
# Limite global de requisições por minuto por IP
THROTTLE_GLOBAL_TTL=60
THROTTLE_GLOBAL_LIMIT=100
# Limite para rotas de autenticação
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=10

# -----------------------------------------------
# LOGS
# -----------------------------------------------
# Nível de log: error | warn | info | debug | verbose
LOG_LEVEL=info
# Habilitar log em arquivo
LOG_TO_FILE=true
# Diretório dos arquivos de log
LOG_DIR=./logs

# -----------------------------------------------
# LGPD
# -----------------------------------------------
# Prazo padrão para responder requisições LGPD (dias)
LGPD_RESPONSE_DEADLINE_DAYS=15
# E-mail do DPO padrão do sistema
DPO_EMAIL=dpo@seudominio.com.br

# -----------------------------------------------
# NGINX (apenas produção)
# -----------------------------------------------
NGINX_HOST=localhost
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
