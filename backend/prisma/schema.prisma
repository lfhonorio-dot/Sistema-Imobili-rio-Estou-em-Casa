  endpointId String
  event      String
  payload    Json     @default("{}")
  status     String
  statusCode Int?
  response   String?
  duration   Int?
  createdAt  DateTime @default(now())
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id])
  @@map("webhook_logs")
}

