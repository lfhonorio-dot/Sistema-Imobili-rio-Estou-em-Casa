}

model AutomationLog {
  id           String   @id @default(uuid())
  automationId String
  workspaceId  String
  status       String   // SUCCESS, FAILURE, SKIPPED
  trigger      String
  entityId     String?
  entityType   String?
  steps        Json     @default("[]")
  errorMessage String?
  duration     Int?     // ms
  createdAt    DateTime @default(now())
