// Schema Prisma - Plataforma Imobiliária Estou em Casa
// Estágio 1: Fundação, Segurança e Conformidade LGPD

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------
// Workspace: representa uma imobiliária/empresa
// -----------------------------------------------
model Workspace {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  cnpj               String?
  address            String?
  phone              String?
  timezone           String    @default("America/Sao_Paulo")
  currency           String    @default("BRL")
  logo               String?
  twoFactorRequired  Boolean   @default(false)
  dpoName            String?
  dpoEmail           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  users              WorkspaceUser[]
  roles              Role[]
  inviteTokens       InviteToken[]
  auditLogs          AuditLog[]
  lgpdConsents       LgpdConsent[]
  privacyPolicies    PrivacyPolicy[]
  lgpdRequests       LgpdRequest[]
  securityIncidents  SecurityIncident[]

  @@map("workspaces")
}

// -----------------------------------------------
// Usuário: pessoa com acesso ao sistema
// -----------------------------------------------
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  phone               String?
  avatar              String?
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  preferences         Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  workspaces          WorkspaceUser[]
  sessions            UserSession[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// -----------------------------------------------
// Relacionamento Usuário <-> Workspace com papel
// -----------------------------------------------
model WorkspaceUser {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  roleId      String
  isOwner     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@map("workspace_users")
}

// -----------------------------------------------
// Papéis de acesso com permissões em JSON
// -----------------------------------------------
model Role {
  id             String          @id @default(uuid())
  workspaceId    String
  name           String
  isSystem       Boolean         @default(false)
  permissions    Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  workspaceUsers WorkspaceUser[]

  @@unique([workspaceId, name])
  @@map("roles")
}

// -----------------------------------------------
// Tokens de convite para novos membros
// -----------------------------------------------
model InviteToken {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  roleId      String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@map("invite_tokens")
}

// -----------------------------------------------
// Sessões de usuário com fingerprint
// -----------------------------------------------
model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  fingerprint  String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

// -----------------------------------------------
// Tokens de redefinição de senha
// -----------------------------------------------
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

// -----------------------------------------------
// Log de auditoria para todas as ações críticas
// -----------------------------------------------
model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String?
  userId      String?
  action      String
  entity      String?
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// -----------------------------------------------
// Consentimento LGPD dos titulares de dados
// -----------------------------------------------
model LgpdConsent {
  id              String        @id @default(uuid())
  workspaceId     String
  subjectEmail    String
  subjectName     String?
  policyVersionId String
  consentedAt     DateTime
  ipAddress       String?
  consentText     String        @db.Text
  withdrawnAt     DateTime?
  createdAt       DateTime      @default(now())
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  policyVersion   PrivacyPolicy @relation(fields: [policyVersionId], references: [id])

  @@map("lgpd_consents")
}

// -----------------------------------------------
// Versões da Política de Privacidade
// -----------------------------------------------
model PrivacyPolicy {
  id          String        @id @default(uuid())
  workspaceId String
  version     String
  content     String        @db.Text
  effectiveAt DateTime
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  consents    LgpdConsent[]

  @@map("privacy_policies")
}

// -----------------------------------------------
// Requisições de direitos dos titulares (LGPD art. 18)
// -----------------------------------------------
model LgpdRequest {
  id           String    @id @default(uuid())
  workspaceId  String
  type         String    // ACCESS | CORRECTION | DELETION | PORTABILITY | REVOKE_CONSENT | INFORMATION
  subjectEmail String
  subjectName  String?
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | REJECTED
  notes        String?   @db.Text
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@map("lgpd_requests")
}

// -----------------------------------------------
// Registro de incidentes de segurança
// -----------------------------------------------
model SecurityIncident {
  id              String    @id @default(uuid())
  workspaceId     String
  title           String
  description     String    @db.Text
  severity        String    // LOW | MEDIUM | HIGH | CRITICAL
  status          String    @default("OPEN") // OPEN | INVESTIGATING | RESOLVED
  affectedData    String?
  notifiedAnpd    Boolean   @default(false)
  notifiedAnpdAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@map("security_incidents")
}
