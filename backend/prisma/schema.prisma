  contractId       String?
  tenantDocument   String
  tenantName       String
  ownerDocument    String
  ownerName        String
  grossAmount      Decimal  @db.Decimal(15, 2)
  irrfRate         Float
  irrfAmount       Decimal  @db.Decimal(15, 2)
  netAmount        Decimal  @db.Decimal(15, 2)
  status           String   @default("PENDING") // PENDING, RETAINED, INFORMED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id])

  @@map("irrf_records")
}

model CarneLeaoRecord {
  id               String   @id @default(uuid())
  workspaceId      String
  period           String   // YYYY-MM
  ownerContactId   String?
  ownerDocument    String
  ownerName        String
  grossIncome      Decimal  @db.Decimal(15, 2)
  deductions       Decimal    @default(0) @db.Decimal(15, 2)
  taxableBase      Decimal  @db.Decimal(15, 2)
  rate             Float
  taxDue           Decimal  @db.Decimal(15, 2)
  darfAmount       Decimal  @db.Decimal(15, 2)
  status           String   @default("CALCULATED") // CALCULATED, PAID, EXPORTED
  paidAt           DateTime?
  calcDetails      Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
