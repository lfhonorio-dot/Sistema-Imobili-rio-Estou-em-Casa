// ══════════════════════════════════════════════════════════════════
// FASE 2 — Cadastros (todas as tabelas abaixo são novas / aditivas)
// ══════════════════════════════════════════════════════════════════

// Proprietários do imóvel (um imóvel pode ter vários). Property.ownerId
// continua existindo e espelha o proprietário principal.
model PropertyOwner {
  id          String    @id @default(uuid())
  workspaceId String
  propertyId  String
  contactId   String
  sharePct    Decimal?  @db.Decimal(5, 2) // % de propriedade (opcional)
  isPrimary   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property  @relation(fields: [propertyId], references: [id])
  contact     Contact   @relation("PropertyCoOwner", fields: [contactId], references: [id])

  @@index([workspaceId, propertyId])
  @@map("property_owners")
}

// Autorização de venda (captação): data, validade, exclusividade,
// comissão combinada e corretor captador.
model PropertyAuthorization {
  id             String    @id @default(uuid())
  workspaceId    String
  propertyId     String
  signedAt       DateTime
  validUntil     DateTime
  exclusive      Boolean   @default(false)
  commissionRate Decimal?  @db.Decimal(5, 2)
  askingPrice    Decimal?  @db.Decimal(15, 2) // valor autorizado para venda
  captorUserId   String?   // WorkspaceUser id do corretor captador
  documentId     String?   // Document com a autorização assinada
  notes          String?
  status         String    @default("ACTIVE") // ACTIVE, CANCELLED (vencida é calculado pela data)
  cancelledAt    DateTime?
  cancelReason   String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  property       Property  @relation(fields: [propertyId], references: [id])

  @@index([workspaceId, validUntil])
  @@map("property_authorizations")
}

// Controle de chaves: cada retirada/devolução é um registro (histórico imutável).
model PropertyKeyMovement {
  id               String    @id @default(uuid())
  workspaceId      String
  propertyId       String
  action           String    // CHECKOUT (retirada), RETURN (devolução)
  keyLabel         String?   // ex.: "Jogo 1 — portão + porta"
  holderName       String    // quem está com a chave
  holderContactId  String?
  userId           String?   // usuário que registrou
  expectedReturnAt DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  property         Property  @relation(fields: [propertyId], references: [id])

  @@index([workspaceId, propertyId])
  @@map("property_key_movements")
}

// Histórico de preço (gravado automaticamente quando o preço muda).
model PropertyPriceHistory {
  id          String   @id @default(uuid())
  workspaceId String
  propertyId  String
  field       String   // SALE_PRICE, RENTAL_PRICE
  oldValue    Decimal? @db.Decimal(15, 2)
  newValue    Decimal? @db.Decimal(15, 2)
  userId      String?
  createdAt   DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id])

  @@index([workspaceId, propertyId])
  @@map("property_price_history")
}

// Arquivos enviados (fotos, documentos). Guardados no próprio banco,
// servidos por URL assinada (HMAC) com validade.
model StoredFile {
  id          String    @id @default(uuid())
  workspaceId String
  fileName    String
  mimeType    String
  size        Int
  sha256      String
  data        Bytes
  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@map("stored_files")
}

// Fornecedores / favorecidos (para contas a pagar).
model Supplier {
  id            String    @id @default(uuid())
  workspaceId   String
  name          String
  personType    String    @default("PJ") // PF, PJ
  document      String?   // CPF ou CNPJ
  email         String?
  phone         String?
  category      String?   // ex.: CARTORIO, PUBLICIDADE, MANUTENCAO, SERVICOS, CORRETOR, OUTRO
  pixKeyType    String?
  pixKey        String?
  bankCode      String?
  agency        String?
  accountNumber String?
  notes         String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
  @@map("suppliers")
}

// Perfil de interesse do cliente comprador (para sugerir imóveis).
model ContactInterestProfile {
  id               String   @id @default(uuid())
  workspaceId      String
  contactId        String   @unique
  propertyTypes    String[] @default([]) // APARTMENT, HOUSE, LAND...
  cities           String[] @default([])
  neighborhoods    String[] @default([])
  minPrice         Decimal? @db.Decimal(15, 2)
  maxPrice         Decimal? @db.Decimal(15, 2)
  minBedrooms      Int?
  minParkingSpaces Int?
  paymentMethods   String[] @default([]) // CASH, FINANCING, FGTS, PERMUTA
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  contact          Contact  @relation(fields: [contactId], references: [id])

  @@index([workspaceId])
  @@map("contact_interest_profiles")
}

// ══════════════════════════════════════════════════════════════════
// FASE 3 — Funil de venda (tabelas novas / aditivas)
// ══════════════════════════════════════════════════════════════════

// Visita a um imóvel. Cada visita gera uma atividade do tipo VISIT (aparece
// em Tarefas e no calendário) e, quando há negócio, avança o funil.
model Visit {
  id            String    @id @default(uuid())
  workspaceId   String
  dealId        String?
  contactId     String
  propertyId    String
  brokerId      String?   // WorkspaceUser id do corretor que acompanha
  scheduledAt   DateTime
  durationMin   Int       @default(60)
  status        String    @default("SCHEDULED") // SCHEDULED, DONE, CANCELLED, NO_SHOW
  feedback      String?   @db.Text // retorno do cliente
  interestLevel String?   // HIGH, MEDIUM, LOW, NONE
  cancelReason  String?
  activityId    String?   // Activity (tipo VISIT) criada junto
  createdById   String?
  completedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deal          Deal?     @relation(fields: [dealId], references: [id])
  contact       Contact   @relation(fields: [contactId], references: [id])
  property      Property  @relation(fields: [propertyId], references: [id])

  @@index([workspaceId, scheduledAt])
  @@map("visits")
}

// Proposta de compra (e contrapropostas encadeadas por parentId).
model Proposal {
  id                  String    @id @default(uuid())
  workspaceId         String
  dealId              String
  contactId           String    // comprador
  propertyId          String
  parentId            String?   // proposta respondida por esta (contraproposta)
  kind                String    @default("OFFER") // OFFER (comprador), COUNTER (vendedor)
  amount              Decimal   @db.Decimal(15, 2)
  paymentMethod       String    // CASH, FINANCING, FGTS, PERMUTA, MIXED
  downPayment         Decimal?  @db.Decimal(15, 2) // entrada / sinal
  financedAmount      Decimal?  @db.Decimal(15, 2)
  fgtsAmount          Decimal?  @db.Decimal(15, 2)
  exchangeDescription String?   // imóvel/bem dado em permuta
  conditions          String?   @db.Text
  validUntil          DateTime
  status              String    @default("OPEN") // OPEN, ACCEPTED, REJECTED, COUNTERED, WITHDRAWN (vencida = calculado)
  decidedAt           DateTime?
  decisionNote        String?
  createdById         String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deal                Deal      @relation(fields: [dealId], references: [id])
  contact             Contact   @relation(fields: [contactId], references: [id])
  property            Property  @relation(fields: [propertyId], references: [id])

  @@index([workspaceId, dealId])
  @@map("proposals")
}

// ══════════════════════════════════════════════════════════════════
// FASE 4 — Pós-venda (tabela nova)
// ══════════════════════════════════════════════════════════════════

// Checklist de pós-venda por contrato (documentos, crédito, ITBI, escritura,
// registro, chaves), com responsável e prazo.
model ContractChecklistItem {
  id            String    @id @default(uuid())
  workspaceId   String
  contractId    String
  key           String    // DOCS_PARTIES, CREDIT_APPROVAL, BANK_APPRAISAL, ITBI, DEED, REGISTRY, KEYS, CUSTOM
  title         String
  order         Int       @default(0)
  responsibleId String?   // WorkspaceUser id
  dueDate       DateTime?
  status        String    @default("PENDING") // PENDING, DONE, NOT_APPLICABLE, CANCELLED
  doneAt        DateTime?
  doneById      String?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, contractId])
  @@map("contract_checklist_items")
}

// ══════════════════════════════════════════════════════════════════
// FASE 5 — Financeiro (tabelas novas)
// ══════════════════════════════════════════════════════════════════

// Cada recebimento/pagamento (baixa) de um lançamento. Permite baixa parcial,
// juros, multa, desconto, estorno e comprovante. O lançamento fica PARTIAL
// enquanto o principal pago < valor, e PAID quando quita.
model FinancialPayment {
  id                String    @id @default(uuid())
  workspaceId       String
  entryId           String
  principal         Decimal   @db.Decimal(15, 2) // quanto abate do valor do lançamento
  interest          Decimal   @default(0) @db.Decimal(15, 2)
  fine              Decimal   @default(0) @db.Decimal(15, 2)
  discount          Decimal   @default(0) @db.Decimal(15, 2)
  total             Decimal   @db.Decimal(15, 2) // principal + juros + multa - desconto (o que entrou/saiu)
  paidAt            DateTime
  method            String?   // BOLETO, PIX, TRANSFER, CASH, CARD, OTHER
  bankAccountId     String?
  source            String    @default("MANUAL") // MANUAL, GATEWAY, RECONCILIATION, LEGACY
  gatewayPaymentId  String?
  receiptFileId     String?   // comprovante (StoredFile)
  notes             String?
  createdById       String?
  reversedAt        DateTime?
  reversalReason    String?
  reversedById      String?
  createdAt         DateTime  @default(now())

  @@index([workspaceId, paidAt])
  @@index([entryId])
  @@map("financial_payments")
}

// Plano de categorias de receita e despesa (configurável).
model FinancialCategory {
  id          String    @id @default(uuid())
  workspaceId String
  type        String    // RECEIVABLE, PAYABLE
  code        String    // gravado em FinancialEntry.category
  name        String
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, type, code])
  @@map("financial_categories")
}

// Centro de custo simples (ex.: Venda, Administrativo, Marketing).
model CostCenter {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@map("cost_centers")
}

// Recorrência mensal real: o sistema gera os lançamentos dos próximos meses
// sozinho (rotina diária), um por competência, sem duplicar.
model RecurringEntry {
  id            String    @id @default(uuid())
  workspaceId   String
  type          String    // RECEIVABLE, PAYABLE
  category      String
  description   String
  amount        Decimal   @db.Decimal(15, 2)
  dayOfMonth    Int       // 1-28
  startDate     DateTime
  endDate       DateTime?
  contactId     String?
  supplierId    String?
  costCenterId  String?
  propertyId    String?
  notes         String?
  isActive      Boolean   @default(true)
  lastCompetence String?  // última competência gerada (AAAA-MM)
  createdById   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, isActive])
  @@map("recurring_entries")
}

// Padrões financeiros da imobiliária (multa e juros sugeridos na baixa).
model WorkspaceFinancialSettings {
  id                 String   @id @default(uuid())
  workspaceId        String   @unique
  finePct            Decimal  @default(2) @db.Decimal(5, 2)   // % multa por atraso
  interestMonthlyPct Decimal  @default(1) @db.Decimal(5, 2)   // % juros ao mês (pro rata dia)
  updatedAt          DateTime @updatedAt

  @@map("workspace_financial_settings")
}

// Eventos de webhook do gateway já processados (idempotência).
model GatewayWebhookEvent {
  id          String   @id @default(uuid())
  workspaceId String
  eventId     String
  event       String
  paymentId   String?
  result      String?
  createdAt   DateTime @default(now())

  @@unique([workspaceId, eventId])
  @@map("gateway_webhook_events")
}
