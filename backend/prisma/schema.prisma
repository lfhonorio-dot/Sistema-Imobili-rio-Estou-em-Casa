// ── ETAPA 6 — AUTOMAÇÕES E NOTIFICAÇÕES ──────────────────────

model Automation {
  id           String   @id @default(uuid())
  workspaceId  String
  name         String
  description  String?
  status       String   @default("ACTIVE") // ACTIVE, PAUSED
  trigger      String   // DEAL_CREATED, DEAL_STAGE_CHANGED, DEAL_WON, DEAL_LOST, etc.
  triggerConfig Json    @default("{}")
  steps        Json     @default("[]") // array de ações/condições
  executions   Int      @default(0)
  successes    Int      @default(0)
  failures     Int      @default(0)
  lastRunAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  logs         AutomationLog[]

  @@map("automations")
}

model AutomationLog {
  id           String   @id @default(uuid())
  automationId String
  workspaceId  String
  status       String   // SUCCESS, FAILURE, SKIPPED
  trigger      String
  entityId     String?
  entityType   String?
  steps        Json     @default("[]")
  errorMessage String?
  duration     Int?     // ms
  createdAt    DateTime @default(now())
  automation   Automation @relation(fields: [automationId], references: [id])

  @@map("automation_logs")
}

model NotificationPreference {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  type        String   // NEW_MESSAGE, LEAD_ASSIGNED, TASK_DUE, CONTRACT_EXPIRING, BOLETO_OVERDUE, DEAL_COLD
  inApp       Boolean  @default(true)
  email       Boolean  @default(false)
  push        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, userId, type])
  @@map("notification_preferences")
}

model ApiKey {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  keyHash     String   @unique
  keyPrefix   String
  scopes      String[] @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  @@map("api_keys")
}

model WebhookEndpoint {
  id          String   @id @default(uuid())
  workspaceId String
  url         String
  events      String[] @default([])
  secret      String
  status      String   @default("ACTIVE")
  lastTriggeredAt DateTime?
  failureCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  logs        WebhookLog[]
  @@map("webhook_endpoints")
}

model WebhookLog {
  id         String   @id @default(uuid())
  endpointId String
  event      String
  payload    Json     @default("{}")
  status     String
  statusCode Int?
  response   String?
  duration   Int?
  createdAt  DateTime @default(now())
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id])
  @@map("webhook_logs")
}

// =============================================
// ETAPA 9 — SUPER ADMIN E CONFIGURAÇÕES AVANÇADAS
// =============================================

model PlatformConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  @@map("platform_configs")
}

model FeatureFlag {
  id           String   @id @default(uuid())
  key          String   @unique
  enabled      Boolean  @default(false)
  description  String?
  workspaceIds String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@map("feature_flags")
}

model WorkspacePlan {
  id            String    @id @default(uuid())
  workspaceId   String    @unique
  plan          String    @default("FREE")
  maxUsers      Int       @default(3)
  maxProperties Int       @default(50)
  maxContacts   Int       @default(500)
  features      String[]  @default([])
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  @@map("workspace_plans")
}

model OnboardingStep {
  id          String    @id @default(uuid())
  workspaceId String
  step        String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  @@unique([workspaceId, step])
  @@map("onboarding_steps")
}
