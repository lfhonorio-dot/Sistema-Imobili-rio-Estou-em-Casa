// Schema Prisma - Plataforma Imobiliária Estou em Casa
// Estágio 1: Fundação, Segurança e Conformidade LGPD
// Estágio 2: CRM Core

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------
// Workspace: representa uma imobiliária/empresa
// -----------------------------------------------
model Workspace {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  cnpj               String?
  address            String?
  phone              String?
  timezone           String    @default("America/Sao_Paulo")
  currency           String    @default("BRL")
  logo               String?
  twoFactorRequired  Boolean   @default(false)
  dpoName            String?
  dpoEmail           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  users              WorkspaceUser[]
  roles              Role[]
  inviteTokens       InviteToken[]
  auditLogs          AuditLog[]
  lgpdConsents       LgpdConsent[]
  privacyPolicies    PrivacyPolicy[]
  lgpdRequests       LgpdRequest[]
  securityIncidents  SecurityIncident[]
  // CRM Core
  contacts           Contact[]
  pipelines          Pipeline[]
  deals              Deal[]
  activities         Activity[]
  documents          Document[]
  tags               Tag[]
  customFields       CustomField[]
  // ERP Imobiliário
  properties         Property[]
  contracts          Contract[]
  financialEntries   FinancialEntry[]
  commissions        Commission[]
  inspections        Inspection[]
  maintenanceOrders  MaintenanceOrder[]

  @@map("workspaces")
}

// -----------------------------------------------
// Usuário: pessoa com acesso ao sistema
// -----------------------------------------------
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  phone               String?
  avatar              String?
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  preferences         Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  workspaces          WorkspaceUser[]
  sessions            UserSession[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// -----------------------------------------------
// Relacionamento Usuário <-> Workspace com papel
// -----------------------------------------------
model WorkspaceUser {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  roleId      String
  isOwner     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@map("workspace_users")
}

// -----------------------------------------------
// Papéis de acesso com permissões em JSON
// -----------------------------------------------
model Role {
  id             String          @id @default(uuid())
  workspaceId    String
  name           String
  isSystem       Boolean         @default(false)
  permissions    Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  workspaceUsers WorkspaceUser[]

  @@unique([workspaceId, name])
  @@map("roles")
}

// -----------------------------------------------
// Tokens de convite para novos membros
// -----------------------------------------------
model InviteToken {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  roleId      String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@map("invite_tokens")
}

// -----------------------------------------------
// Sessões de usuário com fingerprint
// -----------------------------------------------
model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  fingerprint  String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

// -----------------------------------------------
// Tokens de redefinição de senha
// -----------------------------------------------
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

// -----------------------------------------------
// Log de auditoria para todas as ações críticas
// -----------------------------------------------
model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String?
  userId      String?
  action      String
  entity      String?
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// -----------------------------------------------
// Consentimento LGPD dos titulares de dados
// -----------------------------------------------
model LgpdConsent {
  id              String        @id @default(uuid())
  workspaceId     String
  subjectEmail    String
  subjectName     String?
  policyVersionId String
  consentedAt     DateTime
  ipAddress       String?
  consentText     String        @db.Text
  withdrawnAt     DateTime?
  createdAt       DateTime      @default(now())
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  policyVersion   PrivacyPolicy @relation(fields: [policyVersionId], references: [id])

  @@map("lgpd_consents")
}

// -----------------------------------------------
// Versões da Política de Privacidade
// -----------------------------------------------
model PrivacyPolicy {
  id          String        @id @default(uuid())
  workspaceId String
  version     String
  content     String        @db.Text
  effectiveAt DateTime
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  consents    LgpdConsent[]

  @@map("privacy_policies")
}

// -----------------------------------------------
// Requisições de direitos dos titulares (LGPD art. 18)
// -----------------------------------------------
model LgpdRequest {
  id           String    @id @default(uuid())
  workspaceId  String
  type         String    // ACCESS | CORRECTION | DELETION | PORTABILITY | REVOKE_CONSENT | INFORMATION
  subjectEmail String
  subjectName  String?
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | REJECTED
  notes        String?   @db.Text
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@map("lgpd_requests")
}

// -----------------------------------------------
// Registro de incidentes de segurança
// -----------------------------------------------
model SecurityIncident {
  id              String    @id @default(uuid())
  workspaceId     String
  title           String
  description     String    @db.Text
  severity        String    // LOW | MEDIUM | HIGH | CRITICAL
  status          String    @default("OPEN") // OPEN | INVESTIGATING | RESOLVED
  affectedData    String?
  notifiedAnpd    Boolean   @default(false)
  notifiedAnpdAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@map("security_incidents")
}

// =============================================
// CRM CORE - Estágio 2
// =============================================

model Contact {
  id            String    @id @default(uuid())
  workspaceId   String
  type          String    // PERSON, COMPANY
  name          String
  email         String?
  phone         String?
  cpf           String?   // criptografado
  cnpj          String?
  birthDate     DateTime?
  profession    String?
  income        Decimal?  @db.Decimal(15, 2)
  // Empresa
  companyName   String?   // razão social
  tradeName     String?   // nome fantasia
  // Endereço
  zipCode       String?
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  // LGPD
  marketingConsent Boolean @default(false)
  // Metadados
  customFields  Json      @default("{}")
  origin        String?   // MANUAL, META_ADS, GOOGLE_ADS, PORTAL, WHATSAPP, SITE, REFERRAL
  utmSource     String?
  utmCampaign   String?
  utmContent    String?
  utmAdset      String?
  utmAd         String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  tags              ContactTag[]
  deals             Deal[]
  activities        Activity[]
  companyLinks      ContactCompanyLink[] @relation("PersonLinks")
  personLinks       ContactCompanyLink[] @relation("CompanyLinks")
  documents         Document[]
  // ERP: imóveis e contratos
  ownedProperties   Property[] @relation("PropertyOwner")
  contractsAsOwner  Contract[] @relation("ContractOwner")
  contractsAsTenant Contract[] @relation("ContractTenant")

  @@map("contacts")
}

model Tag {
  id          String       @id @default(uuid())
  workspaceId String
  name        String
  color       String       @default("#6366f1")
  module      String       // CONTACT, DEAL, PROPERTY
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  contacts    ContactTag[]
  deals       DealTag[]

  @@unique([workspaceId, name, module])
  @@map("tags")
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model ContactCompanyLink {
  id        String   @id @default(uuid())
  personId  String
  companyId String
  role      String?  // SOCIO, FUNCIONARIO, PROPRIETARIO, INQUILINO
  createdAt DateTime @default(now())
  person    Contact  @relation("PersonLinks", fields: [personId], references: [id])
  company   Contact  @relation("CompanyLinks", fields: [companyId], references: [id])

  @@map("contact_company_links")
}

model CustomField {
  id          String   @id @default(uuid())
  workspaceId String
  module      String   // CONTACT, DEAL, PROPERTY
  name        String
  key         String
  type        String   // TEXT, NUMBER, DATE, SELECT, MULTISELECT, URL, FILE
  options     Json?    // Para SELECT/MULTISELECT
  required    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, module, key])
  @@map("custom_fields")
}

model Pipeline {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  type        String         // SALE, RENTAL, COMMERCIAL, CUSTOM
  isDefault   Boolean        @default(false)
  order       Int            @default(0)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  stages      PipelineStage[]
  deals       Deal[]

  @@map("pipelines")
}

model PipelineStage {
  id               String    @id @default(uuid())
  pipelineId       String
  name             String
  color            String    @default("#6366f1")
  order            Int
  expectedDays     Int?
  isWon            Boolean   @default(false)
  isLost           Boolean   @default(false)
  rottenAfterDays  Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  pipeline         Pipeline  @relation(fields: [pipelineId], references: [id])
  deals            Deal[]
  dealHistory      DealStageHistory[]

  @@map("pipeline_stages")
}

model Deal {
  id              String    @id @default(uuid())
  workspaceId     String
  title           String
  value           Decimal?  @db.Decimal(15, 2)
  contactId       String
  pipelineId      String
  stageId         String
  assigneeId      String?   // WorkspaceUser id
  expectedCloseAt DateTime?
  closedAt        DateTime?
  lostReason      String?
  lostNote        String?
  origin          String?
  utmSource       String?
  utmCampaign     String?
  utmContent      String?
  gclid           String?
  customFields    Json      @default("{}")
  lastActivityAt  DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  contact         Contact       @relation(fields: [contactId], references: [id])
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id])
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  tags            DealTag[]
  stageHistory    DealStageHistory[]
  activities      Activity[]
  properties      DealProperty[]

  @@map("deals")
}

model DealTag {
  dealId String
  tagId  String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
  @@map("deal_tags")
}

model DealProperty {
  dealId     String
  propertyId String
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id])

  @@id([dealId, propertyId])
  @@map("deal_properties")
}

model DealStageHistory {
  id          String        @id @default(uuid())
  dealId      String
  stageId     String
  userId      String?
  daysInStage Int?
  movedAt     DateTime      @default(now())
  deal        Deal          @relation(fields: [dealId], references: [id])
  stage       PipelineStage @relation(fields: [stageId], references: [id])

  @@map("deal_stage_history")
}

model Activity {
  id          String    @id @default(uuid())
  workspaceId String
  type        String    // NOTE, TASK, CALL, VISIT, MEETING, EMAIL, WHATSAPP, STAGE_CHANGE, FIELD_CHANGE
  title       String?
  content     String?   @db.Text
  contactId   String?
  dealId      String?
  userId      String?
  dueAt       DateTime?
  doneAt      DateTime?
  priority    String?   // LOW, MEDIUM, HIGH, URGENT
  reminderAt  DateTime?
  recurrence  String?   // NONE, DAILY, WEEKLY, MONTHLY
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  contact     Contact?  @relation(fields: [contactId], references: [id])
  deal        Deal?     @relation(fields: [dealId], references: [id])

  @@map("activities")
}

model Document {
  id          String    @id @default(uuid())
  workspaceId String
  contactId   String?
  propertyId  String?
  contractId  String?
  name        String
  type        String    // RG, CPF, CNPJ, RENDA, CERTIDAO, ESCRITURA, LAUDO, CONTRATO, OUTRO
  url         String
  size        Int?
  mimeType    String?
  expiresAt   DateTime?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  contact     Contact?  @relation(fields: [contactId], references: [id])
  property    Property? @relation(fields: [propertyId], references: [id])
  contract    Contract? @relation(fields: [contractId], references: [id])

  @@map("documents")
}

// =============================================
// ERP IMOBILIÁRIO - Estágio 3
// =============================================

model Property {
  id               String    @id @default(uuid())
  workspaceId      String
  code             String    // código interno único por workspace
  portalCode       String?   // código de publicação nos portais
  type             String    // APARTMENT, HOUSE, COMMERCIAL, LAND, WAREHOUSE, LAUNCH, RURAL
  purpose          String    // SALE, RENTAL, SALE_RENTAL
  status           String    @default("AVAILABLE") // AVAILABLE, RESERVED, RENTED, SOLD, MAINTENANCE, INACTIVE
  // Endereço
  zipCode          String?
  street           String?
  number           String?
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  latitude         Decimal?  @db.Decimal(10, 8)
  longitude        Decimal?  @db.Decimal(11, 8)
  // Características
  totalArea        Decimal?  @db.Decimal(10, 2)
  privateArea      Decimal?  @db.Decimal(10, 2)
  bedrooms         Int?
  suites           Int?
  bathrooms        Int?
  parkingSpaces    Int?
  floor            Int?
  totalFloors      Int?
  acceptsPets      Boolean   @default(false)
  furnished        Boolean   @default(false)
  // Valores
  salePrice        Decimal?  @db.Decimal(15, 2)
  rentalPrice      Decimal?  @db.Decimal(15, 2)
  iptuMonthly      Decimal?  @db.Decimal(10, 2)
  condoMonthly     Decimal?  @db.Decimal(10, 2)
  // Documentação
  registrationNumber String? // matrícula
  iptuNumber         String?
  // Publicação
  description      String?   @db.Text
  videoUrl         String?
  tourUrl          String?
  // Relações
  ownerId          String?   // Contact id do proprietário
  assigneeId       String?   // WorkspaceUser id do corretor responsável
  tags             String[]  @default([])
  highlights       String[]  @default([]) // exclusividade, permuta, financiamento_cef
  customFields     Json      @default("{}")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace      @relation(fields: [workspaceId], references: [id])
  owner            Contact?       @relation("PropertyOwner", fields: [ownerId], references: [id])
  photos           PropertyPhoto[]
  statusHistory    PropertyStatusHistory[]
  contracts        Contract[]
  inspections      Inspection[]
  maintenanceOrders MaintenanceOrder[]
  documents        Document[]
  dealProperties   DealProperty[]

  @@unique([workspaceId, code])
  @@map("properties")
}

model PropertyPhoto {
  id          String   @id @default(uuid())
  propertyId  String
  url         String
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_photos")
}

model PropertyStatusHistory {
  id         String   @id @default(uuid())
  propertyId String
  status     String
  userId     String?
  note       String?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])

  @@map("property_status_history")
}

model Contract {
  id               String    @id @default(uuid())
  workspaceId      String
  type             String    // SALE, RENTAL_RESIDENTIAL, RENTAL_COMMERCIAL, BROKERAGE
  status           String    @default("DRAFT") // DRAFT, ACTIVE, TERMINATED, RESCINDED
  propertyId       String
  // Partes
  ownerId          String?   // Contact id proprietário/vendedor
  tenantId         String?   // Contact id inquilino/comprador
  guarantorIds     String[]  @default([])
  // Datas
  startDate        DateTime?
  endDate          DateTime?
  signedAt         DateTime?
  // Locação
  rentalValue      Decimal?  @db.Decimal(15, 2)
  adjustmentIndex  String?   // IGPM, IPCA, IPC
  adjustmentMonth  Int?      // mês de reajuste
  dueDay           Int?      // dia de vencimento (1-31)
  lateFee          Decimal?  @db.Decimal(5, 2) // % multa atraso
  punctualDiscount Decimal?  @db.Decimal(5, 2) // % desconto pontualidade
  includesWater    Boolean   @default(false)
  includesElec     Boolean   @default(false)
  includesCondo    Boolean   @default(false)
  includesIptu     Boolean   @default(false)
  customClauses    String?   @db.Text
  // Venda
  saleValue        Decimal?  @db.Decimal(15, 2)
  paymentMethod    String?   // CASH, FINANCING, INSTALLMENT
  commissionRate   Decimal?  @db.Decimal(5, 2)
  proposalDate     DateTime?
  acceptanceDate   DateTime?
  deedDate         DateTime?
  keyDeliveryDate  DateTime?
  // Arquivo
  signedFileUrl    String?
  notes            String?   @db.Text
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace   @relation(fields: [workspaceId], references: [id])
  property         Property    @relation(fields: [propertyId], references: [id])
  owner            Contact?    @relation("ContractOwner", fields: [ownerId], references: [id])
  tenant           Contact?    @relation("ContractTenant", fields: [tenantId], references: [id])
  financialEntries FinancialEntry[]
  commissions      Commission[]
  inspections      Inspection[]
  documents        Document[]

  @@map("contracts")
}

model FinancialEntry {
  id                String    @id @default(uuid())
  workspaceId       String
  type              String    // RECEIVABLE, PAYABLE
  category          String    // RENT, SALE, ADMINISTRATION, COMMISSION, MAINTENANCE, MARKETING, OTHER
  description       String
  amount            Decimal   @db.Decimal(15, 2)
  dueDate           DateTime
  paidAt            DateTime?
  paidAmount        Decimal?  @db.Decimal(15, 2)
  status            String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED, EXEMPT
  paymentMethod     String?   // BOLETO, PIX, TRANSFER, CASH
  contractId        String?
  propertyId        String?
  contactId         String?   // proprietário ou inquilino
  installment       Int?      // número da parcela
  totalInstallments Int?
  notes             String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace  @relation(fields: [workspaceId], references: [id])
  contract          Contract?  @relation(fields: [contractId], references: [id])

  @@map("financial_entries")
}

model Commission {
  id          String    @id @default(uuid())
  workspaceId String
  contractId  String
  userId      String    // WorkspaceUser id do corretor
  amount      Decimal   @db.Decimal(15, 2)
  rate        Decimal   @db.Decimal(5, 2)
  status      String    @default("PENDING") // PENDING, PAID
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  contract    Contract  @relation(fields: [contractId], references: [id])

  @@map("commissions")
}

model Inspection {
  id          String    @id @default(uuid())
  workspaceId String
  type        String    // ENTRY, EXIT
  propertyId  String
  contractId  String?
  scheduledAt DateTime?
  doneAt      DateTime?
  notes       String?   @db.Text
  reportUrl   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  property    Property   @relation(fields: [propertyId], references: [id])
  contract    Contract?  @relation(fields: [contractId], references: [id])
  rooms       InspectionRoom[]

  @@map("inspections")
}

model InspectionRoom {
  id           String    @id @default(uuid())
  inspectionId String
  name         String    // sala, quarto, banheiro, cozinha, área externa
  items        Json      @default("[]") // [{name, condition, notes, photoUrls:[]}]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("inspection_rooms")
}

model MaintenanceOrder {
  id              String    @id @default(uuid())
  workspaceId     String
  propertyId      String
  contractId      String?
  type            String    // ELECTRICAL, PLUMBING, STRUCTURAL, PAINTING, LOCKSMITH, OTHER
  priority        String    // URGENT, HIGH, MEDIUM, LOW
  requestedBy     String    // OWNER, TENANT, BROKER, AGENCY
  title           String
  description     String    @db.Text
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, AWAITING_QUOTE, COMPLETED, CANCELLED
  assigneeId      String?   // internal user
  supplierName    String?
  quotedAmount    Decimal?  @db.Decimal(15, 2)
  finalAmount     Decimal?  @db.Decimal(15, 2)
  approvedAt      DateTime?
  completedAt     DateTime?
  paidBy          String?   // OWNER, AGENCY, TENANT
  beforePhotos    String[]  @default([])
  afterPhotos     String[]  @default([])
  serviceOrderUrl String?
  notes           String?   @db.Text
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  property        Property  @relation(fields: [propertyId], references: [id])

