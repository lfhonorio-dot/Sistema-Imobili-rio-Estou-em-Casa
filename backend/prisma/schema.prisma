generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  retirementPlan      RetirementPlan?
  cashFlowEntries     CashFlowEntry[]
  importLogs          ImportLog[]
  importRules         ImportRule[]
  importMatchingRules ImportMatchingRule[]
  monthlySnapshots    MonthlySnapshot[]
}

enum AssetType {
  RENDA_FIXA
  FII
  ACAO
  PREVIDENCIA
  COE
  CAIXA
  RECEBIVEIS
}

enum Indexer {
  IPCA
  CDI
  SELIC
  PREFIXADO
  IGPM
  OUTRO
}

enum LiquidityType {
  D0
  D1
  NO_VENCIMENTO
  ILIQUIDO
}

model InvestmentAsset {
  id             String    @id @default(cuid())
  type           AssetType
  name           String
  ticker         String?
  issuer         String?
  broker         String?
  contractNumber String?

  applicationDate DateTime?
  maturityDate    DateTime?
  exDividendDate  DateTime?

  investedAmount Decimal  @db.Decimal(18, 2)
  currentValue   Decimal  @db.Decimal(18, 2)
  quantity       Decimal? @db.Decimal(18, 6)
  averagePrice   Decimal? @db.Decimal(18, 6)
  currentPrice   Decimal? @db.Decimal(18, 6)

  indexer    Indexer?
  rate       Decimal? @db.Decimal(10, 4)
  grossRate  Decimal? @db.Decimal(10, 4)
  isIRExempt Boolean  @default(false)
  rating     String?
  liquidity  LiquidityType?

  segment              String?
  lastDividendPerShare Decimal? @db.Decimal(18, 6)
  monthlyDY            Decimal? @db.Decimal(10, 4)
  pvp                  Decimal? @db.Decimal(10, 4)
  beta                 Decimal? @db.Decimal(10, 4)

  insurerName         String?
  planType            String?
  taxRegime           String?
  monthlyContribution Decimal? @db.Decimal(18, 2)
  beneficiaries       String?

  minReturn        Decimal? @db.Decimal(18, 2)
  baseReturn       Decimal? @db.Decimal(18, 2)
  maxReturn        Decimal? @db.Decimal(18, 2)
  capitalProtected Boolean  @default(false)
  underlyingAsset  String?

  lastImportedAt DateTime?
  importSource   String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  dividendHistory DividendHistory[]

  @@index([type])
  @@index([maturityDate])
  @@index([deletedAt])
}

model DividendHistory {
  id          String          @id @default(cuid())
  asset       InvestmentAsset @relation(fields: [assetId], references: [id])
  assetId     String
  month       Int
  year        Int
  amount      Decimal         @db.Decimal(18, 6)
  totalAmount Decimal         @db.Decimal(18, 2)
  paymentDate DateTime?
  createdAt   DateTime        @default(now())

  @@unique([assetId, year, month])
  @@index([assetId, year, month])
}

enum PropertyClassification {
  PARA_RENDA
  USO_PROPRIO
  A_COMERCIALIZAR
}

enum PropertyType {
  APARTAMENTO
  CASA
  SITIO
  SALA_COMERCIAL
  GALPAO
  TERRENO
  LOTE
  RURAL
}

enum RentAdjustmentIndex {
  IGPM
  IPCA
  OUTRO
}

model Property {
  id                String                 @id @default(cuid())
  name              String
  classification    PropertyClassification
  propertyType      PropertyType
  currentValuation  Decimal                @db.Decimal(18, 2)
  lastValuationDate DateTime?
  notes             String?

  rentAmount      Decimal?            @db.Decimal(18, 2)
  rentStatus      String?
  tenantName      String?
  contractEndDate DateTime?
  adjustmentIndex RentAdjustmentIndex?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([classification])
  @@index([deletedAt])
}

model ReceivablePortfolio {
  id                    String   @id @default(cuid())
  name                  String
  developmentName       String?
  presentValue          Decimal  @db.Decimal(18, 2)
  futureTotalReceivable Decimal  @db.Decimal(18, 2)
  averageRemainingTerm  Int?
  impliedMonthlyRate    Decimal? @db.Decimal(10, 6)
  monthlyReceivedAmount Decimal  @db.Decimal(18, 2) @default(0)
  expectedMonthlyAmount Decimal? @db.Decimal(18, 2)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  monthlyHistory ReceivableMonthlyHistory[]
}

model ReceivableMonthlyHistory {
  id             String              @id @default(cuid())
  portfolio      ReceivablePortfolio @relation(fields: [portfolioId], references: [id])
  portfolioId    String
  month          Int
  year           Int
  expectedAmount Decimal             @db.Decimal(18, 2)
  receivedAmount Decimal             @db.Decimal(18, 2)
  createdAt      DateTime            @default(now())

  @@unique([portfolioId, year, month])
}

enum CashFlowCategory {
  ALUGUEL
  RECEBIVEIS_LOTEAMENTO
  APOSENTADORIA
  RENDIMENTO_FII
  RENDIMENTO_RENDA_FIXA
  DIVIDENDO
  SALARIO
  OUTRAS_RECEITAS
  IPTU
  CONDOMINIO
  SEGURO
  MANUTENCAO_IMOVEL
  IMPOSTOS_ESCRITORIO
  IR_DARF
  CUSTO_VIDA
  PLANO_SAUDE
  OUTRAS_DESPESAS
}

enum CashFlowType {
  RECEITA
  DESPESA
}

model CashFlowEntry {
  id          String           @id @default(cuid())
  user        User             @relation(fields: [userId], references: [id])
  userId      String
  type        CashFlowType
  category    CashFlowCategory
  description String?
  amount      Decimal          @db.Decimal(18, 2)
  month       Int
  year        Int
  date        DateTime?
  isRecurring Boolean          @default(false)
  propertyId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, year, month])
  @@index([category])
}

model RetirementPlan {
  id                       String  @id @default(cuid())
  user                     User    @relation(fields: [userId], references: [id])
  userId                   String  @unique
  desiredMonthlyIncome     Decimal @db.Decimal(18, 2)
  estimatedMonthlyExpenses Decimal @db.Decimal(18, 2)
  expectedIpca             Decimal @db.Decimal(10, 4) @default(4.5)
  expectedCdi              Decimal @db.Decimal(10, 4) @default(10.5)
  lifeExpectancy           Int     @default(85)

  targetFixedIncome Decimal @db.Decimal(10, 2) @default(50)
  targetFii         Decimal @db.Decimal(10, 2) @default(22.5)
  targetStocks      Decimal @db.Decimal(10, 2) @default(12.5)
  targetReceivables Decimal @db.Decimal(10, 2) @default(12.5)
  targetLiquidity   Decimal @db.Decimal(10, 2) @default(7.5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonthlySnapshot {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  month  Int
  year   Int

  totalPatrimony      Decimal @db.Decimal(18, 2)
  fixedIncomeTotal    Decimal @db.Decimal(18, 2)
  fiiTotal            Decimal @db.Decimal(18, 2)
  stocksTotal         Decimal @db.Decimal(18, 2)
  pensionTotal        Decimal @db.Decimal(18, 2)
  coeTotal            Decimal @db.Decimal(18, 2)
  cashTotal           Decimal @db.Decimal(18, 2)
  receivablesTotal    Decimal @db.Decimal(18, 2)
  propertiesRentTotal Decimal @db.Decimal(18, 2)
  propertiesOwnTotal  Decimal @db.Decimal(18, 2)
  propertiesSaleTotal Decimal @db.Decimal(18, 2)

  monthlyPassiveIncome Decimal @db.Decimal(18, 2)
  monthlyExpenses      Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

enum ImportFormat {
  OFX
  CSV
  XLS
  PDF
  JSON
}

enum ImportSource {
  EQI
  BRADESCO
  ITAU
  SANTANDER
  BB
  CAIXA
  XP
  BTG
  RICO
  NUINVEST
  B3
  OUTRO
}

model ImportLog {
  id                      String        @id @default(cuid())
  user                    User          @relation(fields: [userId], references: [id])
  userId                  String
  fileName                String
  format                  ImportFormat
  source                  ImportSource?
  importedAt              DateTime      @default(now())
  recordsTotal            Int           @default(0)
  recordsDuplicate        Int           @default(0)
  recordsError            Int           @default(0)
  recordsUpdatedPortfolio Int           @default(0)
  recordsUpdatedCashFlow  Int           @default(0)
  rollbackAvailable       Boolean       @default(true)
  rollbackData            Json?

  entries BankStatementEntry[]
}

model BankStatementEntry {
  id          String            @id @default(cuid())
  importLog   ImportLog         @relation(fields: [importLogId], references: [id])
  importLogId String
  date        DateTime
  description String
  amount      Decimal           @db.Decimal(18, 2)
  entryType   String
  category    CashFlowCategory?
  isDuplicate Boolean           @default(false)
  isProcessed Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([importLogId])
}

enum TargetModule {
  CASH_FLOW
  PORTFOLIO
  RECEIVABLE
}

model ImportRule {
  id             String            @id @default(cuid())
  user           User              @relation(fields: [userId], references: [id])
  userId         String
  keyword        String
  targetModule   TargetModule
  targetCategory CashFlowCategory?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
}

model ImportMatchingRule {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  pattern     String
  assetId     String?
  propertyId  String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model PatrimonialAnalysis {
  id            String   @id @default(cuid())
  userId        String
  generatedAt   DateTime @default(now())
  dataSnapshot  Json
  agentResponse Json
  modelUsed     String   @default("claude-opus-4-6")
  tokensUsed    Int      @default(0)
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)

  conversations AnalysisConversation[]

  @@index([userId, generatedAt])
}

model AnalysisConversation {
  id         String              @id @default(cuid())
  analysis   PatrimonialAnalysis @relation(fields: [analysisId], references: [id])
  analysisId String
  question   String
  response   String
  askedAt    DateTime            @default(now())
  tokensUsed Int                 @default(0)

  @@index([analysisId])
}

model AdvisorKnowledgeBase {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
