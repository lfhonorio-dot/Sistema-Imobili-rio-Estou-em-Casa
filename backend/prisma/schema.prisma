  year         Int
  contractId   String?
  type         String   // LOCACAO, VENDA, INTERMEDIACAO
  locadorDoc   String
  locadorName  String
  locatarioDoc String
  locatarioName String
  propertyAddress String
  startDate    DateTime?
  endDate      DateTime?
  monthlyValue Decimal? @db.Decimal(15, 2)
  totalValue   Decimal? @db.Decimal(15, 2)
  commissionAmount Decimal? @db.Decimal(15, 2)
  // Declarante do rateio (imobiliária ou corretor parceiro PJ)
  declarantDoc     String?
  declarantName    String?
  declarantType    String?  // PJ, PF
