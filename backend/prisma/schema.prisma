  workspaceId  String
  name         String
  description  String?
  status       String   @default("ACTIVE") // ACTIVE, PAUSED
  trigger      String   // DEAL_CREATED, DEAL_STAGE_CHANGED, DEAL_WON, DEAL_LOST, etc.
