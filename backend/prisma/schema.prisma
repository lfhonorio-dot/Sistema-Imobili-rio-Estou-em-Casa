// Schema Prisma - Plataforma Imobiliária Estou em Casa
// Estágio 1: Fundação, Segurança e Conformidade LGPD
// Estágio 2: CRM Core

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------
// Workspace: representa uma imobiliária/empresa
// -----------------------------------------------
model Workspace {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  cnpj               String?
  address            String?
  phone              String?
  timezone           String    @default("America/Sao_Paulo")
  currency           String    @default("BRL")
  logo               String?
  twoFactorRequired  Boolean   @default(false)
  dpoName            String?
  dpoEmail           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  users              WorkspaceUser[]
  roles              Role[]
  inviteTokens       InviteToken[]
  auditLogs          AuditLog[]
  lgpdConsents       LgpdConsent[]
  privacyPolicies    PrivacyPolicy[]
  lgpdRequests       LgpdRequest[]
  securityIncidents  SecurityIncident[]
  // CRM Core
  contacts           Contact[]
  pipelines          Pipeline[]
  deals              Deal[]
  activities         Activity[]
  documents          Document[]
  tags               Tag[]
  customFields       CustomField[]
  // ERP Imobiliário
  properties         Property[]
  contracts          Contract[]
  financialEntries   FinancialEntry[]
  commissions        Commission[]
  inspections        Inspection[]
  maintenanceOrders  MaintenanceOrder[]
  // Hub de Comunicação
  conversations      Conversation[]
  messages           Message[]
  emailTemplates     EmailTemplate[]
  notifications      Notification[]
  whatsAppConfig     WhatsAppConfig?
  // Backfill Etapa 3
  signatureEnvelopes SignatureEnvelope[]
  gatewayConfigs     PaymentGatewayConfig[]
  boletos            Boleto[]
  cnabFiles          CnabFile[]
  splitRecipients    SplitRecipient[]
  bankAccounts       BankAccount[]
  taxConfig          TaxConfig?
  nfseRecords        NfseRecord[]
  fiscalObligations  FiscalObligation[]
  dimobRecords       DimobRecord[]
  irrfRecords        IrrfRecord[]
  carneLeaoRecords   CarneLeaoRecord[]
  // Etapa 5 — Marketing
  marketingIntegrations MarketingIntegration[]
  adCampaigns           AdCampaign[]
  portalIntegrations    PortalIntegration[]
  portalPublications    PortalPublication[]
  // Etapa 6 — Automações e Notificações
  automations           Automation[]
  notificationPreferences NotificationPreference[]
  // Etapa 8 — Integrações
  apiKeys              ApiKey[]
  webhookEndpoints     WebhookEndpoint[]
  // Etapa 9 — Admin & Configurações Avançadas
  plan                 WorkspacePlan?
  onboardingSteps      OnboardingStep[]

  @@map("workspaces")
}

// -----------------------------------------------
// Usuário: pessoa com acesso ao sistema
// -----------------------------------------------
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  phone               String?
  avatar              String?
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  preferences         Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  workspaces          WorkspaceUser[]
  sessions            UserSession[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// -----------------------------------------------
// Relacionamento Usuário <-> Workspace com papel
// -----------------------------------------------
model WorkspaceUser {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  roleId      String
  isOwner     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@map("workspace_users")
}

// -----------------------------------------------
// Papéis de acesso com permissões em JSON
// -----------------------------------------------
model Role {
  id             String          @id @default(uuid())
  workspaceId    String
  name           String
  isSystem       Boolean         @default(false)
  permissions    Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  workspaceUsers WorkspaceUser[]

  @@unique([workspaceId, name])
  @@map("roles")
}

// -----------------------------------------------
// Tokens de convite para novos membros
// -----------------------------------------------
model InviteToken {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  roleId      String
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@map("invite_tokens")
}

// -----------------------------------------------
// Sessões de usuário com fingerprint
// -----------------------------------------------
model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  fingerprint  String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

// -----------------------------------------------
// Tokens de redefinição de senha
// -----------------------------------------------
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

// -----------------------------------------------
// Log de auditoria para todas as ações críticas
// -----------------------------------------------
model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String?
  userId      String?
  action      String
  entity      String?
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// -----------------------------------------------
// Consentimento LGPD dos titulares de dados
// -----------------------------------------------
model LgpdConsent {
  id              String        @id @default(uuid())
  workspaceId     String
  subjectEmail    String
  subjectName     String?
  policyVersionId String
  consentedAt     DateTime
  ipAddress       String?
  consentText     String        @db.Text
  withdrawnAt     DateTime?
  createdAt       DateTime      @default(now())
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  policyVersion   PrivacyPolicy @relation(fields: [policyVersionId], references: [id])

  @@map("lgpd_consents")
}

// -----------------------------------------------
// Versões da Política de Privacidade
// -----------------------------------------------
model PrivacyPolicy {
  id          String        @id @default(uuid())
  workspaceId String
  version     String
  content     String        @db.Text
  effectiveAt DateTime
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  consents    LgpdConsent[]

  @@map("privacy_policies")
}

// -----------------------------------------------
// Requisições de direitos dos titulares (LGPD art. 18)
// -----------------------------------------------
model LgpdRequest {
  id           String    @id @default(uuid())
  workspaceId  String
  type         String    // ACCESS | CORRECTION | DELETION | PORTABILITY | REVOKE_CONSENT | INFORMATION
  subjectEmail String
  subjectName  String?
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | REJECTED
  notes        String?   @db.Text
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@map("lgpd_requests")
}

// -----------------------------------------------
// Registro de incidentes de segurança
// -----------------------------------------------
model SecurityIncident {
  id              String    @id @default(uuid())
  workspaceId     String
  title           String
  description     String    @db.Text
  severity        String    // LOW | MEDIUM | HIGH | CRITICAL
  status          String    @default("OPEN") // OPEN | INVESTIGATING | RESOLVED
  affectedData    String?
  notifiedAnpd    Boolean   @default(false)
  notifiedAnpdAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@map("security_incidents")
}

// =============================================
// CRM CORE - Estágio 2
// =============================================

model Contact {
  id            String    @id @default(uuid())
  workspaceId   String
  type          String    // PERSON, COMPANY
  name          String
  email         String?
  phone         String?
  cpf           String?   // criptografado
  cnpj          String?
  birthDate     DateTime?
  profession    String?
  income        Decimal?  @db.Decimal(15, 2)
  // Empresa
  companyName   String?   // razão social
  tradeName     String?   // nome fantasia
  // Endereço
  zipCode       String?
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  // LGPD
  marketingConsent Boolean @default(false)
  // Metadados
  customFields  Json      @default("{}")
  origin        String?   // MANUAL, META_ADS, GOOGLE_ADS, PORTAL, WHATSAPP, SITE, REFERRAL
  utmSource     String?
  utmCampaign   String?
  utmContent    String?
  utmAdset      String?
  utmAd         String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  tags              ContactTag[]
  deals             Deal[]
  activities        Activity[]
  companyLinks      ContactCompanyLink[] @relation("PersonLinks")
  personLinks       ContactCompanyLink[] @relation("CompanyLinks")
  documents         Document[]
  // ERP: imóveis e contratos
  ownedProperties   Property[] @relation("PropertyOwner")
  contractsAsOwner  Contract[] @relation("ContractOwner")
  contractsAsTenant Contract[] @relation("ContractTenant")
  // Hub: conversas
  conversations     Conversation[]

  @@map("contacts")
}

model Tag {
  id          String       @id @default(uuid())
  workspaceId String
  name        String
  color       String       @default("#6366f1")
  module      String       // CONTACT, DEAL, PROPERTY
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  contacts    ContactTag[]
  deals       DealTag[]

  @@unique([workspaceId, name, module])
  @@map("tags")
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model ContactCompanyLink {
  id        String   @id @default(uuid())
  personId  String
  companyId String
  role      String?  // SOCIO, FUNCIONARIO, PROPRIETARIO, INQUILINO
  createdAt DateTime @default(now())
  person    Contact  @relation("PersonLinks", fields: [personId], references: [id])
  company   Contact  @relation("CompanyLinks", fields: [companyId], references: [id])

  @@map("contact_company_links")
}

model CustomField {
  id          String   @id @default(uuid())
  workspaceId String
  module      String   // CONTACT, DEAL, PROPERTY
  name        String
  key         String
  type        String   // TEXT, NUMBER, DATE, SELECT, MULTISELECT, URL, FILE
  options     Json?    // Para SELECT/MULTISELECT
  required    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, module, key])
  @@map("custom_fields")
}

model Pipeline {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  type        String         // SALE, RENTAL, COMMERCIAL, CUSTOM
  isDefault   Boolean        @default(false)
  order       Int            @default(0)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  stages      PipelineStage[]
  deals       Deal[]

  @@map("pipelines")
}

model PipelineStage {
  id               String    @id @default(uuid())
  pipelineId       String
  name             String
  color            String    @default("#6366f1")
  order            Int
  expectedDays     Int?
  isWon            Boolean   @default(false)
  isLost           Boolean   @default(false)
  rottenAfterDays  Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  pipeline         Pipeline  @relation(fields: [pipelineId], references: [id])
  deals            Deal[]
  dealHistory      DealStageHistory[]

  @@map("pipeline_stages")
}

model Deal {
  id              String    @id @default(uuid())
  workspaceId     String
  title           String
  value           Decimal?  @db.Decimal(15, 2)
  contactId       String
  pipelineId      String
  stageId         String
  assigneeId      String?   // WorkspaceUser id
  expectedCloseAt DateTime?
  closedAt        DateTime?
  lostReason      String?
  lostNote        String?
  origin          String?
  utmSource       String?
  utmCampaign     String?
  utmContent      String?
  gclid           String?
  customFields    Json      @default("{}")
  lastActivityAt  DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  contact         Contact       @relation(fields: [contactId], references: [id])
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id])
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  tags            DealTag[]
  stageHistory    DealStageHistory[]
  activities      Activity[]
  properties      DealProperty[]

  @@map("deals")
}

model DealTag {
  dealId String
  tagId  String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
  @@map("deal_tags")
}

model DealProperty {
  dealId     String
  propertyId String
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id])

  @@id([dealId, propertyId])
  @@map("deal_properties")
}

model DealStageHistory {
  id          String        @id @default(uuid())
  dealId      String
  stageId     String
  userId      String?
  daysInStage Int?
  movedAt     DateTime      @default(now())
  deal        Deal          @relation(fields: [dealId], references: [id])
  stage       PipelineStage @relation(fields: [stageId], references: [id])

  @@map("deal_stage_history")
}

model Activity {
  id          String    @id @default(uuid())
  workspaceId String
  type        String    // NOTE, TASK, CALL, VISIT, MEETING, EMAIL, WHATSAPP, STAGE_CHANGE, FIELD_CHANGE
  title       String?
  content     String?   @db.Text
  contactId   String?
  dealId      String?
  userId      String?
  dueAt       DateTime?
  doneAt      DateTime?
  priority    String?   // LOW, MEDIUM, HIGH, URGENT
  reminderAt  DateTime?
  recurrence  String?   // NONE, DAILY, WEEKLY, MONTHLY
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  contact     Contact?  @relation(fields: [contactId], references: [id])
  deal        Deal?     @relation(fields: [dealId], references: [id])

  @@map("activities")
}

model Document {
  id          String    @id @default(uuid())
  workspaceId String
  contactId   String?
  propertyId  String?
  contractId  String?
  name        String
  type        String    // RG, CPF, CNPJ, RENDA, CERTIDAO, ESCRITURA, LAUDO, CONTRATO, OUTRO
  url         String
  size        Int?
  mimeType    String?
  expiresAt   DateTime?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  contact     Contact?  @relation(fields: [contactId], references: [id])
  property    Property? @relation(fields: [propertyId], references: [id])
  contract    Contract? @relation(fields: [contractId], references: [id])

  @@map("documents")
}

// =============================================
// ERP IMOBILIÁRIO - Estágio 3
// =============================================

model Property {
  id               String    @id @default(uuid())
  workspaceId      String
  code             String    // código interno único por workspace
  portalCode       String?   // código de publicação nos portais
  type             String    // APARTMENT, HOUSE, COMMERCIAL, LAND, WAREHOUSE, LAUNCH, RURAL
  purpose          String    // SALE, RENTAL, SALE_RENTAL
  status           String    @default("AVAILABLE") // AVAILABLE, RESERVED, RENTED, SOLD, MAINTENANCE, INACTIVE
  // Endereço
  zipCode          String?
  street           String?
  number           String?
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  latitude         Decimal?  @db.Decimal(10, 8)
  longitude        Decimal?  @db.Decimal(11, 8)
  // Características
  totalArea        Decimal?  @db.Decimal(10, 2)
  privateArea      Decimal?  @db.Decimal(10, 2)
  bedrooms         Int?
  suites           Int?
  bathrooms        Int?
  parkingSpaces    Int?
  floor            Int?
  totalFloors      Int?
  acceptsPets      Boolean   @default(false)
  furnished        Boolean   @default(false)
  // Valores
  salePrice        Decimal?  @db.Decimal(15, 2)
  rentalPrice      Decimal?  @db.Decimal(15, 2)
  iptuMonthly      Decimal?  @db.Decimal(10, 2)
  condoMonthly     Decimal?  @db.Decimal(10, 2)
  // Documentação
  registrationNumber String? // matrícula
  iptuNumber         String?
  // Publicação
  description      String?   @db.Text
  videoUrl         String?
  tourUrl          String?
  // Relações
  ownerId          String?   // Contact id do proprietário
  assigneeId       String?   // WorkspaceUser id do corretor responsável
  tags             String[]  @default([])
  highlights       String[]  @default([]) // exclusividade, permuta, financiamento_cef
  customFields     Json      @default("{}")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace      @relation(fields: [workspaceId], references: [id])
  owner            Contact?       @relation("PropertyOwner", fields: [ownerId], references: [id])
  photos           PropertyPhoto[]
  statusHistory    PropertyStatusHistory[]
  contracts        Contract[]
  inspections      Inspection[]
  maintenanceOrders MaintenanceOrder[]
  documents        Document[]
  dealProperties   DealProperty[]
  portalPublications PortalPublication[]

  @@unique([workspaceId, code])
  @@map("properties")
}

model PropertyPhoto {
  id          String   @id @default(uuid())
  propertyId  String
  url         String
  caption     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_photos")
}

model PropertyStatusHistory {
  id         String   @id @default(uuid())
  propertyId String
  status     String
  userId     String?
  note       String?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])

  @@map("property_status_history")
}

model Contract {
  id               String    @id @default(uuid())
  workspaceId      String
  type             String    // SALE, RENTAL_RESIDENTIAL, RENTAL_COMMERCIAL, BROKERAGE
  status           String    @default("DRAFT") // DRAFT, ACTIVE, TERMINATED, RESCINDED
  propertyId       String
  // Partes
  ownerId          String?   // Contact id proprietário/vendedor
  tenantId         String?   // Contact id inquilino/comprador
  guarantorIds     String[]  @default([])
  // Datas
  startDate        DateTime?
  endDate          DateTime?
  signedAt         DateTime?
  // Locação
  rentalValue      Decimal?  @db.Decimal(15, 2)
  adjustmentIndex  String?   // IGPM, IPCA, IPC
  adjustmentMonth  Int?      // mês de reajuste
  dueDay           Int?      // dia de vencimento (1-31)
  lateFee          Decimal?  @db.Decimal(5, 2) // % multa atraso
  punctualDiscount Decimal?  @db.Decimal(5, 2) // % desconto pontualidade
  includesWater    Boolean   @default(false)
  includesElec     Boolean   @default(false)
  includesCondo    Boolean   @default(false)
  includesIptu     Boolean   @default(false)
  customClauses    String?   @db.Text
  // Venda
  saleValue        Decimal?  @db.Decimal(15, 2)
  paymentMethod    String?   // CASH, FINANCING, INSTALLMENT
  commissionRate   Decimal?  @db.Decimal(5, 2)
  proposalDate     DateTime?
  acceptanceDate   DateTime?
  deedDate         DateTime?
  keyDeliveryDate  DateTime?
  // Arquivo
  signedFileUrl    String?
  notes            String?   @db.Text
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace   @relation(fields: [workspaceId], references: [id])
  property         Property    @relation(fields: [propertyId], references: [id])
  owner            Contact?    @relation("ContractOwner", fields: [ownerId], references: [id])
  tenant           Contact?    @relation("ContractTenant", fields: [tenantId], references: [id])
  financialEntries FinancialEntry[]
  commissions      Commission[]
  inspections      Inspection[]
  documents        Document[]
  signatureEnvelopes SignatureEnvelope[]
  splitRules       SplitRule[]

  @@map("contracts")
}

model FinancialEntry {
  id                String    @id @default(uuid())
  workspaceId       String
  type              String    // RECEIVABLE, PAYABLE
  category          String    // RENT, SALE, ADMINISTRATION, COMMISSION, MAINTENANCE, MARKETING, OTHER
  description       String
  amount            Decimal   @db.Decimal(15, 2)
  dueDate           DateTime
  paidAt            DateTime?
  paidAmount        Decimal?  @db.Decimal(15, 2)
  status            String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED, EXEMPT
  paymentMethod     String?   // BOLETO, PIX, TRANSFER, CASH
  contractId        String?
  propertyId        String?
  contactId         String?   // proprietário ou inquilino
  installment       Int?      // número da parcela
  totalInstallments Int?
  notes             String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace  @relation(fields: [workspaceId], references: [id])
  contract          Contract?  @relation(fields: [contractId], references: [id])
  boleto            Boleto?

  @@map("financial_entries")
}

model Commission {
  id          String    @id @default(uuid())
  workspaceId String
  contractId  String
  userId      String    // WorkspaceUser id do corretor
  amount      Decimal   @db.Decimal(15, 2)
  rate        Decimal   @db.Decimal(5, 2)
  status      String    @default("PENDING") // PENDING, PAID
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  contract    Contract  @relation(fields: [contractId], references: [id])

  @@map("commissions")
}

model Inspection {
  id          String    @id @default(uuid())
  workspaceId String
  type        String    // ENTRY, EXIT
  propertyId  String
  contractId  String?
  scheduledAt DateTime?
  doneAt      DateTime?
  notes       String?   @db.Text
  reportUrl   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  property    Property   @relation(fields: [propertyId], references: [id])
  contract    Contract?  @relation(fields: [contractId], references: [id])
  rooms       InspectionRoom[]

  @@map("inspections")
}

model InspectionRoom {
  id           String    @id @default(uuid())
  inspectionId String
  name         String    // sala, quarto, banheiro, cozinha, área externa
  items        Json      @default("[]") // [{name, condition, notes, photoUrls:[]}]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("inspection_rooms")
}

model MaintenanceOrder {
  id              String    @id @default(uuid())
  workspaceId     String
  propertyId      String
  contractId      String?
  type            String    // ELECTRICAL, PLUMBING, STRUCTURAL, PAINTING, LOCKSMITH, OTHER
  priority        String    // URGENT, HIGH, MEDIUM, LOW
  requestedBy     String    // OWNER, TENANT, BROKER, AGENCY
  title           String
  description     String    @db.Text
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, AWAITING_QUOTE, COMPLETED, CANCELLED
  assigneeId      String?   // internal user
  supplierName    String?
  quotedAmount    Decimal?  @db.Decimal(15, 2)
  finalAmount     Decimal?  @db.Decimal(15, 2)
  approvedAt      DateTime?
  completedAt     DateTime?
  paidBy          String?   // OWNER, AGENCY, TENANT
  beforePhotos    String[]  @default([])
  afterPhotos     String[]  @default([])
  serviceOrderUrl String?
  notes           String?   @db.Text
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  property        Property  @relation(fields: [propertyId], references: [id])

  @@map("maintenance_orders")
}

// =============================================
// HUB DE COMUNICAÇÃO - Etapa 4
// =============================================

model Conversation {
  id            String    @id @default(uuid())
  workspaceId   String
  channel       String    // WHATSAPP, EMAIL, INSTAGRAM, CHAT_INTERNO
  status        String    @default("OPEN") // OPEN, PENDING, RESOLVED, ARCHIVED
  contactId     String?
  assigneeId    String?
  subject       String?
  externalId    String?
  lastMessageAt DateTime?
  tags          String[]  @default([])
  metadata      Json      @default("{}")
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  contact       Contact?     @relation(fields: [contactId], references: [id])
  messages      Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  workspaceId    String
  conversationId String
  direction      String   // INBOUND, OUTBOUND
  channel        String
  type           String   @default("TEXT")
  body           String?  @db.Text
  mediaUrl       String?
  mediaType      String?
  status         String   @default("SENT")
  externalId     String?
  senderId       String?
  errorMessage   String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace    @relation(fields: [workspaceId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@map("messages")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  subject     String
  body        String   @db.Text
  variables   String[] @default([])
  category    String
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@map("email_templates")
}

model Notification {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  type        String
  title       String
  body        String
  entityType  String?
  entityId    String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@map("notifications")
}

model WhatsAppConfig {
  id            String   @id @default(uuid())
  workspaceId   String   @unique
  phoneNumberId String
  accessToken   String
  webhookSecret String
  businessId    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  @@map("whatsapp_configs")
}

// =============================================
// BACKFILL ETAPA 3 — SUB-MÓDULOS AVANÇADOS
// =============================================

// ─── 3.3-A ASSINATURA ELETRÔNICA ────────────

model SignatureEnvelope {
  id            String   @id @default(uuid())
  workspaceId   String
  contractId    String?
  title         String
  documentUrl   String   // URL no MinIO do PDF original
  documentHash  String   // SHA-256 do PDF antes do envio
  signedUrl     String?  // URL do PDF assinado final
  signedHash    String?  // SHA-256 do PDF assinado
  certUrl       String?  // URL do certificado de conclusão
  type          String   @default("ADVANCED") // SIMPLE, ADVANCED, QUALIFIED
  order         String   @default("PARALLEL") // PARALLEL, SEQUENTIAL
  deadline      DateTime?
  message       String?  @db.Text
  status        String   @default("DRAFT") // DRAFT, SENT, PARTIAL, COMPLETED, EXPIRED, CANCELLED
  completedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  workspace     Workspace  @relation(fields: [workspaceId], references: [id])
  contract      Contract?  @relation(fields: [contractId], references: [id])
  signatories   SignatureSignatory[]

  @@map("signature_envelopes")
}

model SignatureSignatory {
  id             String   @id @default(uuid())
  envelopeId     String
  name           String
  email          String
  phone          String?
  cpf            String?
  role           String   // LOCATARIO, LOCADOR, FIADOR, IMOBILIARIA, TESTEMUNHA
  order          Int      @default(0)
  token          String   @unique // token único de 64 chars
  tokenExpiresAt DateTime?
  status         String   @default("PENDING") // PENDING, SENT, VIEWED, SIGNED, REJECTED
  otpHash        String?  // hash do OTP usado
  signedAt       DateTime?
  rejectedAt     DateTime?
  rejectionReason String?
  ipAddress      String?
  userAgent      String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  envelope       SignatureEnvelope @relation(fields: [envelopeId], references: [id])
  auditEvents    SignatureAuditEvent[]

  @@map("signature_signatories")
}

model SignatureAuditEvent {
  id           String   @id @default(uuid())
  signatoryId  String
  event        String   // LINK_SENT, DOCUMENT_OPENED, OTP_REQUESTED, OTP_VALIDATED, SIGNED, REJECTED
  ipAddress    String?
  userAgent    String?
  latitude     Float?
  longitude    Float?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  signatory    SignatureSignatory @relation(fields: [signatoryId], references: [id])

  @@map("signature_audit_events")
}

// ─── 3.4-C BOLETOS E COBRANÇAS ──────────────

model PaymentGatewayConfig {
  id            String   @id @default(uuid())
  workspaceId   String
  provider      String   // ASAAS, EFI, PAGARME, ZOOP, ITAU, BRADESCO, BB
  name          String
  apiKey        String   // criptografada
  apiSecret     String?  // criptografada
  webhookSecret String?
  environment   String   @default("SANDBOX") // SANDBOX, PRODUCTION
  accountId     String?
  agencia       String?
  conta         String?
  convenio      String?
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  metadata      Json     @default("{}")
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  boletos       Boleto[]
  splitRecipients SplitRecipient[]

  @@map("payment_gateway_configs")
}

model Boleto {
  id               String   @id @default(uuid())
  workspaceId      String
  gatewayId        String?
  financialEntryId String?  @unique
  contractId       String?
  contactId        String?
  gatewayBoletoId  String?  // ID no gateway externo
  nossoNumero      String?
  linhaDigitavel   String?
  codigoBarras     String?
  pixQrCode        String?  @db.Text
  pixCopiaECola    String?  @db.Text
  amount           Float
  dueDate          DateTime
  issueDate        DateTime @default(now())
  paidAt           DateTime?
  paidAmount       Float?
  cancelledAt      DateTime?
  status           String   @default("PENDING") // PENDING, REGISTERED, SENT, VIEWED, PAID, OVERDUE, CANCELLED
  registeredAt     DateTime?
  bankslipUrl      String?
  fine             Float    @default(2.0)   // % multa
  interest         Float    @default(0.033) // % juros diário
  discount         Float    @default(0.0)   // % desconto pontualidade
  instructions     String?  @db.Text
  description      String?
  cnabReturnLines  Json     @default("[]")
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workspace        Workspace            @relation(fields: [workspaceId], references: [id])
  gateway          PaymentGatewayConfig? @relation(fields: [gatewayId], references: [id])
  financialEntry   FinancialEntry?       @relation(fields: [financialEntryId], references: [id])

  @@map("boletos")
}

model CnabFile {
  id          String   @id @default(uuid())
  workspaceId String
  gatewayId   String?
  type        String   // REMESSA, RETORNO
  format      String   // CNAB240, CNAB400
  filename    String
  fileUrl     String?  // URL no MinIO
  fileHash    String?
  status      String   @default("PENDING") // PENDING, PROCESSING, PROCESSED, ERROR
  recordCount Int      @default(0)
  processedAt DateTime?
  errorLog    String?  @db.Text
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  records     CnabRecord[]

  @@map("cnab_files")
}

model CnabRecord {
  id          String   @id @default(uuid())
  cnabFileId  String
  lineNumber  Int
  occurrence  String?  // 06=Liquidação, 09=Baixa, 02=Entrada Confirmada, etc.
  nossoNumero String?
  amount      Float?
  paidAt      DateTime?
  boletoId    String?
  status      String   @default("PENDING") // PENDING, MATCHED, ERROR
  errorMsg    String?
  rawLine     String?  @db.Text
  createdAt   DateTime @default(now())
  cnabFile    CnabFile @relation(fields: [cnabFileId], references: [id])

  @@map("cnab_records")
}

// ─── 3.4-D SPLIT DE PAGAMENTO ───────────────

model SplitRecipient {
  id              String   @id @default(uuid())
  workspaceId     String
  gatewayId       String?
  contactId       String?
  name            String
  document        String   // CPF ou CNPJ
  documentType    String   // CPF, CNPJ
  email           String?
  phone           String?
  pixKeyType      String?  // CPF, CNPJ, EMAIL, PHONE, RANDOM
  pixKey          String?
  bankCode        String?
  agency          String?
  accountNumber   String?
  accountType     String?  // CHECKING, SAVINGS
  gatewayRecipientId String?
  kycStatus       String   @default("PENDING") // PENDING, SUBMITTED, APPROVED, REJECTED, SUSPENDED
  kycSubmittedAt  DateTime?
  kycApprovedAt   DateTime?
  kycRejectedAt   DateTime?
  kycReason       String?
  documentUrl     String?  // documento de identidade no MinIO
  isActive        Boolean  @default(true)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace            @relation(fields: [workspaceId], references: [id])
  gateway         PaymentGatewayConfig? @relation(fields: [gatewayId], references: [id])
  splitRules      SplitRule[]
  splitTransactions SplitTransaction[]

  @@map("split_recipients")
}

model SplitRule {
  id           String   @id @default(uuid())
  workspaceId  String
  contractId   String
  recipientId  String
  type         String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  value        Float    // % ou valor fixo
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  contract     Contract       @relation(fields: [contractId], references: [id])
  recipient    SplitRecipient @relation(fields: [recipientId], references: [id])

  @@map("split_rules")
}

model SplitTransaction {
  id                 String   @id @default(uuid())
  workspaceId        String
  financialEntryId   String?
  recipientId        String
  gatewayTransactionId String?
  amount             Float
  status             String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, REVERSED
  processedAt        DateTime?
  failReason         String?
  description        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  recipient          SplitRecipient @relation(fields: [recipientId], references: [id])

  @@map("split_transactions")
}

// ─── 3.4-E INTEGRAÇÃO BANCÁRIA ──────────────

model BankAccount {
  id                  String   @id @default(uuid())
  workspaceId         String
  name                String
  bankCode            String?
  bankName            String?
  agency              String?
  accountNumber       String?
  accountType         String   @default("CHECKING") // CHECKING, SAVINGS
  pixKey              String?
  openFinanceId       String?  // ID do consentimento Open Finance
  openFinanceConsent  String?  // token de consentimento
  consentExpiresAt    DateTime?
  balance             Float    @default(0)
  balanceDate         DateTime?
  isDefault           Boolean  @default(false)
  isActive            Boolean  @default(true)
  deletedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id])
  transactions        BankTransaction[]
  reconciliations     BankReconciliation[]

  @@map("bank_accounts")
}

model BankTransaction {
  id              String   @id @default(uuid())
  workspaceId     String
  bankAccountId   String
  externalId      String?  // ID no banco ou Open Finance
  date            DateTime
  amount          Float    // positivo=crédito, negativo=débito
  description     String?
  type            String?  // PIX, TED, DOC, BOLETO, TARIFA, etc.
  counterpart     String?  // nome do pagador/recebedor
  counterpartDoc  String?
  balance         Float?
  reconciled      Boolean  @default(false)
  financialEntryId String?
  importSource    String?  // OPEN_FINANCE, OFX, CNAB, MANUAL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bankAccount     BankAccount    @relation(fields: [bankAccountId], references: [id])
  reconciliations BankReconciliation[]

  @@map("bank_transactions")
}

model BankReconciliation {
  id                String   @id @default(uuid())
  workspaceId       String
  bankAccountId     String
  bankTransactionId String?
  financialEntryId  String?
  status            String   @default("PENDING") // PENDING, AUTO, MANUAL, IGNORED
  confidence        Float?   // 0-1 score de confiança no match automático
  reconciledAt      DateTime?
  reconciledBy      String?  // userId
  notes             String?
  createdAt         DateTime @default(now())
  bankAccount       BankAccount       @relation(fields: [bankAccountId], references: [id])
  bankTransaction   BankTransaction?  @relation(fields: [bankTransactionId], references: [id])

  @@map("bank_reconciliations")
}

// ─── 3.4-F MÓDULO FISCAL ────────────────────

